DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kutirgrs_v2
SECRET_KEY=change-this-in-production
APP_ENV=development
# JSON list or comma-separated. Parent-shell unquoted [a,b] also accepted.
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
# Local default is admin/admin. Startup creates the user only if missing — it
# never rehashes an existing admin on restart. Keep this aligned with the DB.
ADMIN_PASSWORD=admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kutirgrs.local

# Public SPA origin used in password-reset emails (no trailing slash).
FRONTEND_BASE_URL=http://localhost:5173

# SMTP for forgot-password magic links. If SMTP_HOST is empty, the API logs the
# reset URL instead of sending mail (convenient for local/dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
