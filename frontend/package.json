{
  "name": "kutirgrs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "dev:ui": "bash ../scripts/dev-ui.sh",
    "dev:check": "tsc -b && vite --port 5173 --host",
    "check:field-registry": "node scripts/check-field-registry.mjs",
    "check:field-registry-models": "node scripts/check-field-registry-models.mjs",
    "check:academic-year": "node scripts/check-academic-year.mjs",
    "build": "tsc -b && npm run check:field-registry && npm run check:field-registry-models && npm run check:academic-year && npm run check:pipeline-stages && vite build",
    "check:pipeline-stages": "node scripts/check-pipeline-stages.mjs",
    "lint": "oxlint",
    "preview": "vite preview --port 5173",
    "test:e2e": "playwright test",
    "test:e2e:headed": "HEADED=1 playwright test"
  },
  "dependencies": {
    "@parivaar/ui": "file:../../parivaar-ui",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
